  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=KERNELOS-PC\MSSQLSERVER02;Initial Catalog=TechZone</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>cfe79157-0ad9-4d96-9855-3306e9c39431</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT
    b.nombre AS NombreBodega,
    c.nombre AS NombreCategoria,
    p.nombre AS NombreProducto,
    p.marca AS Marca,
    pv.codigoSKU AS SKU,
    pv.configuracionTexto AS Configuracion,
    i.cantidadDisponible AS CantidadDisponible,
    i.cantidadReservada AS CantidadReservada,
    i.umbralReorden AS UmbralReorden,
    i.ubicacionEstante AS UbicacionEstante,
    CASE
        WHEN i.cantidadDisponible &lt;= i.umbralReorden THEN 'Reorden necesario'
        ELSE 'Stock suficiente'
    END AS EstadoInventario
FROM inventario.Inventario i
INNER JOIN inventario.Bodega b
    ON i.idBodega = b.idBodega
INNER JOIN catalogo.ProductoVariante pv
    ON i.idVariante = pv.idVariante
INNER JOIN catalogo.Producto p
    ON pv.idProducto = p.idProducto
INNER JOIN catalogo.Categoria c
    ON p.idCategoria = c.idCategoria
WHERE
    b.is_active = 1
    AND p.is_active = 1
    AND pv.is_active = 1
ORDER BY
    b.nombre,
    c.nombre,
    p.nombre,
    pv.codigoSKU;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
