  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=.;Initial Catalog=TechZone</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>6bcf9846-cbea-4181-b486-d43b69431aa1</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 
    p.idPedido AS [Número de Pedido],
    p.fechaPedido AS [Fecha del Pedido],
    (c.primerNombre + ' ' + c.primerApellido) AS [Cliente],
    ep.nombre AS [Estado del Pedido],
    p.montoTotalFacturado AS [Monto Total],
    p.notas AS [Notas]
FROM ventas.Pedido p
INNER JOIN clientes.Cliente c ON p.idCliente = c.idCliente
INNER JOIN ref.EstadoPedido ep ON p.idEstadoPedido = ep.idEstado
ORDER BY p.fechaPedido DESC;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Número_de_Pedido">
          <DataField>Número de Pedido</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Fecha_del_Pedido">
          <DataField>Fecha del Pedido</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Cliente">
          <DataField>Cliente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Estado_del_Pedido">
          <DataField>Estado del Pedido</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Monto_Total">
          <DataField>Monto Total</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Notas">
          <DataField>Notas</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
