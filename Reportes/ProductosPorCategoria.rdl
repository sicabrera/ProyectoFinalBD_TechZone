  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=KERNELOS-PC\MSSQLSERVER02;Initial Catalog=TechZone</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>95416fe4-e4da-44c1-978a-def177ffc358</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT
    c.idCategoria AS IdCategoria,
    c.nombre AS NombreCategoria,
    p.idProducto AS IdProducto,
    p.nombre AS NombreProducto,
    p.marca AS Marca,
    pv.codigoSKU AS SKU,
    pv.configuracionTexto AS Configuracion,
    pv.precioActual AS PrecioActual,
    pv.moneda AS Moneda
FROM catalogo.Categoria c
INNER JOIN catalogo.Producto p
    ON c.idCategoria = p.idCategoria
INNER JOIN catalogo.ProductoVariante pv
    ON p.idProducto = pv.idProducto
WHERE 
    c.is_active = 1
    AND p.is_active = 1
    AND pv.is_active = 1
ORDER BY 
    c.nombre,
    p.nombre,
    pv.codigoSKU;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="IdCategoria">
          <DataField>IdCategoria</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="NombreCategoria">
          <DataField>NombreCategoria</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IdProducto">
          <DataField>IdProducto</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="NombreProducto">
          <DataField>NombreProducto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Marca">
          <DataField>Marca</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SKU">
          <DataField>SKU</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Configuracion">
          <DataField>Configuracion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PrecioActual">
          <DataField>PrecioActual</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Moneda">
          <DataField>Moneda</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
