  <DataSources>
    <DataSource Name="DataSource1">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=.;Initial Catalog=TechZone</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>3b8790c1-575e-403f-a84c-bd4478ebd270</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>select 
    p.nombrePais as [País],
    ci.nombreCiudad as [Ciudad],
    es.nombreEstado as [Estado],
    (c.primerNombre + ' ' + isnull(c.segundoNombre + ' ', '') + c.primerApellido + ' ' + isnull(c.segundoApellido, '')) as [Cliente],
    c.email as [Email],
    isnull(c.telefono, 'No registrado') as [Teléfono],
    format(c.fechaRegistro, 'yyyy-MM-dd') as [Fecha de Registro]
from clientes.Cliente c
    inner join geo.Ciudad ci on c.idCiudadPredeterminada = ci.idCiudad
    inner join geo.Estado es on ci.idEstado = es.idEstado
    inner join geo.Pais p on es.idPais = p.idPais
where c.deleted_at is null
order by p.nombrePais, es.nombreEstado, ci.nombreCiudad, c.primerApellido;</CommandText>
      </Query>
      <Fields>
        <Field Name="País">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>País</DataField>
        </Field>
        <Field Name="Ciudad">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Ciudad</DataField>
        </Field>
        <Field Name="Estado">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Estado</DataField>
        </Field>
        <Field Name="Cliente">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Cliente</DataField>
        </Field>
        <Field Name="Email">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Email</DataField>
        </Field>
        <Field Name="Teléfono">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Teléfono</DataField>
        </Field>
        <Field Name="Fecha_de_Registro">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Fecha de Registro</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
