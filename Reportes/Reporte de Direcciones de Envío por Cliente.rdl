          <DataField>Apartamento</DataField>
        </Field>
        <Field Name="Ciudad">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Ciudad</DataField>
        </Field>
        <Field Name="Estado">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Estado</DataField>
        </Field>
        <Field Name="País">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>País</DataField>
        </Field>
        <Field Name="Dirección_Predeterminada">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Dirección Predeterminada</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
