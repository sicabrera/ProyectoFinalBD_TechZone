  <DataSources>
    <DataSource Name="DataSource1">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=.;Initial Catalog=TechZone</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>c56921c4-d7d2-4783-917c-ac8fa95b14a0</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>select 
    (c.primerNombre + ' ' + c.primerApellido) as [Cliente],
    cd.alias as [Alias de Dirección],
    cd.calle as [Calle],
    cd.numero as [Número],
    isnull(cd.apartamento, 'N/A') as [Apartamento],
    ci.nombreCiudad as [Ciudad],
    es.nombreEstado as [Estado],
    p.nombrePais as [País],
    case when cd.predeterminada = 1 then 'Sí' else 'No' end as [Dirección Predeterminada]
from clientes.ClienteDireccion cd
    inner join clientes.Cliente c on cd.idCliente = c.idCliente
    inner join geo.Ciudad ci on cd.idCiudad = ci.idCiudad
    inner join geo.Estado es on ci.idEstado = es.idEstado
    inner join geo.Pais p on es.idPais = p.idPais
where cd.deleted_at is null 
  and c.deleted_at is null
order by c.primerApellido, cd.predeterminada desc;</CommandText>
      </Query>
      <Fields>
        <Field Name="Cliente">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Cliente</DataField>
        </Field>
        <Field Name="Alias_de_Dirección">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Alias de Dirección</DataField>
        </Field>
        <Field Name="Calle">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Calle</DataField>
        </Field>
        <Field Name="Número">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Número</DataField>
