  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=.;Initial Catalog=TechZone</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>b13c2f1c-08b8-4bf4-988f-d140faae25d5</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>select 
    pr.nombre as [Producto],
    pv.configuracionTexto as [Variante],
    (select avg(cast(r_avg.calificacion as decimal(3,1))) 
     from social.Resena r_avg 
     where r_avg.idVariante = pv.idVariante and r_avg.deleted_at is null) as [Promedio Calificación Variante],
    (c.primerNombre + ' ' + c.primerApellido) as [Cliente],
    r.calificacion as [Calificación Individual],
    isnull(r.comentario, '(Sin comentario)') as [Comentario],
    format(r.fechaResena, 'yyyy-MM-dd HH:mm') as [Fecha de Reseña],
    case when r.verificada = 1 then 'Sí' else 'No' end as [Compra Verificada]
from social.Resena r
    inner join catalogo.ProductoVariante pv on r.idVariante = pv.idVariante
    inner join catalogo.Producto pr on pv.idProducto = pr.idProducto
    inner join clientes.Cliente c on r.idCliente = c.idCliente
where r.deleted_at is null
order by pr.nombre, [Promedio Calificación Variante] desc, r.fechaResena desc;</CommandText>
      </Query>
      <Fields>
        <Field Name="Producto">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Producto</DataField>
        </Field>
        <Field Name="Variante">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Variante</DataField>
        </Field>
        <Field Name="Promedio_Calificación_Variante">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Promedio Calificación Variante</DataField>
        </Field>
        <Field Name="Cliente">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Cliente</DataField>
        </Field>
        <Field Name="Calificación_Individual">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Calificación Individual</DataField>
        </Field>
        <Field Name="Comentario">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Comentario</DataField>
        </Field>
        <Field Name="Fecha_de_Reseña">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Fecha de Reseña</DataField>
        </Field>
        <Field Name="Compra_Verificada">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Compra Verificada</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
