<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
	<df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
	<AutoRefresh>0</AutoRefresh>
	<DataSources>
		<DataSource Name="Report2">
			<ConnectionProperties>
				<DataProvider>SQL</DataProvider>
				<ConnectString>Data Source=.;Initial Catalog=TechZone</ConnectString>
				<IntegratedSecurity>true</IntegratedSecurity>
			</ConnectionProperties>
			<rd:SecurityType>Integrated</rd:SecurityType>
		</DataSource>
	</DataSources>
	<DataSets>
		<DataSet Name="DataSet1">
			<Query>
				<DataSourceName>Report2</DataSourceName>
				<CommandText>
					SELECT
					p.idPedido AS Pedido,
					t.nombreEmpresa AS Transportista,
					e.numeroTracking AS NumeroTracking,
					e.fechaEnvio AS FechaEnvio,
					e.fechaEntregaEstimada AS FechaEstimadaEntrega,
					ee.nombre AS EstadoEnvio,
					t.tarifaBase AS TarifaBase,
					t.tiempoEntregaPromedio_dias AS TiempoPromedioEntrega
					FROM envios.Envio e
					INNER JOIN ventas.Pedido p
					ON e.idPedido = p.idPedido
					INNER JOIN envios.Transportista t
					ON e.idTransportista = t.idTransportista
					INNER JOIN ref.EstadoEnvio ee
					ON e.idEstadoEnvio = ee.idEstadoEnvio
					ORDER BY
					t.nombreEmpresa ASC,
					e.fechaEnvio DESC;
				</CommandText>
			</Query>
			<Fields>
				<Field Name="Pedido">
					<DataField>Pedido</DataField>
					<rd:TypeName>System.Int32</rd:TypeName>
				</Field>
				<Field Name="Transportista">
					<DataField>Transportista</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="NumeroTracking">
					<DataField>NumeroTracking</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="FechaEnvio">
					<DataField>FechaEnvio</DataField>
					<rd:TypeName>System.DateTime</rd:TypeName>
				</Field>
				<Field Name="FechaEstimadaEntrega">
					<DataField>FechaEstimadaEntrega</DataField>
					<rd:TypeName>System.DateTime</rd:TypeName>
				</Field>
				<Field Name="EstadoEnvio">
					<DataField>EstadoEnvio</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="TarifaBase">
					<DataField>TarifaBase</DataField>
					<rd:TypeName>System.Decimal</rd:TypeName>
				</Field>
				<Field Name="TiempoPromedioEntrega">
					<DataField>TiempoPromedioEntrega</DataField>
					<rd:TypeName>System.Int32</rd:TypeName>
				</Field>
			</Fields>
		</DataSet>
	</DataSets>
