  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=.;Initial Catalog=TechZone</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>424ed975-6459-46be-b8b9-d0f011121c00</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 
    p.idPedido AS Pedido,
    pg.fechaTransaccion AS FechaTransaccion,
    mp.nombre AS MetodoPago,
    mp.tipo AS TipoMetodo,
    pg.monto AS Monto,
    epg.nombre AS EstadoPago,
    pg.referenciaGateway AS ReferenciaGateway
FROM pagos.Pago pg
INNER JOIN ventas.Pedido p 
    ON pg.idPedido = p.idPedido
INNER JOIN pagos.MetodoPago mp 
    ON pg.idMetodoPago = mp.idMetodo
INNER JOIN ref.EstadoPago epg 
    ON pg.idEstadoPago = epg.idEstadoPago
ORDER BY 
    mp.nombre ASC, 
    pg.fechaTransaccion DESC;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Pedido">
          <DataField>Pedido</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="FechaTransaccion">
          <DataField>FechaTransaccion</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="MetodoPago">
          <DataField>MetodoPago</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TipoMetodo">
          <DataField>TipoMetodo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Monto">
          <DataField>Monto</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="EstadoPago">
          <DataField>EstadoPago</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ReferenciaGateway">
          <DataField>ReferenciaGateway</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
