  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=.;Initial Catalog=TechZone</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>4ab5cb60-4c75-4197-9060-a17236a4e511</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 
    p.idPedido AS [Pedido],
    p.fechaPedido AS [Fecha],
    (pr.nombre + ' - ' + pv.configuracionTexto) AS [Producto],
    pv.codigoSKU AS [SKU],
    dp.cantidad AS [Cantidad],
    dp.precioSnapshot AS [Precio],
    (dp.cantidad * dp.precioSnapshot) AS [Subtotal]
FROM ventas.DetallePedido dp
INNER JOIN ventas.Pedido p ON dp.idPedido = p.idPedido
INNER JOIN catalogo.ProductoVariante pv ON dp.idVariante = pv.idVariante
INNER JOIN catalogo.Producto pr ON pv.idProducto = pr.idProducto
ORDER BY p.fechaPedido DESC, p.idPedido;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Pedido">
          <DataField>Pedido</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Producto">
          <DataField>Producto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SKU">
          <DataField>SKU</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Cantidad">
          <DataField>Cantidad</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Precio">
          <DataField>Precio</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Subtotal">
          <DataField>Subtotal</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
