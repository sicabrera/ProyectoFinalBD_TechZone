  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=.;Initial Catalog=TechZone</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>a0767c3d-9856-4ddd-8793-e3f181a87f3f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 
    phe.idPedido AS [Pedido],
    ep_ant.nombre AS [Estado Anterior],
    ep_nue.nombre AS [Estado Nuevo],
    phe.fechaCambio AS [Fecha de cambio],
    phe.observacion AS [Observación]
FROM ventas.PedidoHistorialEstado phe
INNER JOIN ventas.Pedido p ON phe.idPedido = p.idPedido
LEFT JOIN ref.EstadoPedido ep_ant ON phe.idEstadoAnterior = ep_ant.idEstado
INNER JOIN ref.EstadoPedido ep_nue ON phe.idEstadoNuevo = ep_nue.idEstado
ORDER BY phe.fechaCambio DESC;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Pedido">
          <DataField>Pedido</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Estado_Anterior">
          <DataField>Estado Anterior</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Estado_Nuevo">
          <DataField>Estado Nuevo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha_de_cambio">
          <DataField>Fecha de cambio</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Observación">
          <DataField>Observación</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
