  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=KERNELOS-PC\MSSQLSERVER02;Initial Catalog=TechZone</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>a3fbe8a6-398c-42bc-9a0e-cf1ee5d7d51d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT
    cl.primerNombre + ' ' + cl.primerApellido AS Cliente,
    cl.email AS Email,
    ca.idCarrito AS IdCarrito,
    ca.fechaCreacion AS FechaCreacion,
    c.nombre AS Categoria,
    p.nombre AS Producto,
    p.marca AS Marca,
    pv.codigoSKU AS SKU,
    ci.cantidad AS Cantidad,
    pv.precioActual AS PrecioUnitario,
    ci.cantidad * pv.precioActual AS TotalCarrito,
    pv.moneda AS Moneda
FROM social.Carrito ca
INNER JOIN clientes.Cliente cl
    ON ca.idCliente = cl.idCliente
INNER JOIN social.CarritoItem ci
    ON ca.idCarrito = ci.idCarrito
INNER JOIN catalogo.ProductoVariante pv
    ON ci.idVariante = pv.idVariante
INNER JOIN catalogo.Producto p
    ON pv.idProducto = p.idProducto
INNER JOIN catalogo.Categoria c
    ON p.idCategoria = c.idCategoria
WHERE
    ca.deleted_at IS NULL
    AND ci.deleted_at IS NULL
    AND cl.is_active = 1
    AND p.is_active = 1
    AND pv.is_active = 1
ORDER BY
    cl.primerApellido,
    cl.primerNombre,
    ca.fechaCreacion,
    c.nombre,
    p.nombre;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
