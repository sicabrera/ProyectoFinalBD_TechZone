	<DataSources>
		<DataSource Name="DataSource1">
			<ConnectionProperties>
				<DataProvider>SQL</DataProvider>
				<ConnectString>Data Source=KERNELOS-PC\MSSQLSERVER02;Initial Catalog=TechZone</ConnectString>
				<IntegratedSecurity>true</IntegratedSecurity>
			</ConnectionProperties>
			<rd:SecurityType>Integrated</rd:SecurityType>
			<rd:DataSourceID>17998334-76f1-4772-ae2f-5c78385e6fee</rd:DataSourceID>
		</DataSource>
	</DataSources>
	<DataSets>
		<DataSet Name="DataSet1">
			<Query>
				<DataSourceName>DataSource1</DataSourceName>
				<CommandText>
					SELECT
					c.nombre AS Categoria,
					p.nombre AS Producto,
					p.marca AS Marca,
					p.peso_kg AS PesoKg,
					pv.idVariante AS IdVariante,
					pv.codigoSKU AS SKU,
					pv.configuracionTexto AS Configuracion,
					pv.precioActual AS PrecioActual,
					pv.moneda AS Moneda,
					CASE
					WHEN pv.is_active = 1 THEN 'Activo'
					ELSE 'Inactivo'
					END AS EstadoVariante
					FROM catalogo.Producto p
					INNER JOIN catalogo.Categoria c
					ON p.idCategoria = c.idCategoria
					INNER JOIN catalogo.ProductoVariante pv
					ON p.idProducto = pv.idProducto
					WHERE
					p.is_active = 1
					AND c.is_active = 1
					ORDER BY
					c.nombre,
					p.nombre,
					pv.precioActual;
				</CommandText>
				<rd:UseGenericDesigner>true</rd:UseGenericDesigner>
			</Query>
			<Fields>
				<Field Name="Categoria">
					<DataField>Categoria</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="Producto">
					<DataField>Producto</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="Marca">
					<DataField>Marca</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="PesoKg">
					<DataField>PesoKg</DataField>
					<rd:TypeName>System.Decimal</rd:TypeName>
				</Field>
				<Field Name="IdVariante">
					<DataField>IdVariante</DataField>
					<rd:TypeName>System.Int32</rd:TypeName>
				</Field>
				<Field Name="SKU">
					<DataField>SKU</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="Configuracion">
					<DataField>Configuracion</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="PrecioActual">
					<DataField>PrecioActual</DataField>
					<rd:TypeName>System.Decimal</rd:TypeName>
				</Field>
				<Field Name="Moneda">
					<DataField>Moneda</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="EstadoVariante">
					<DataField>EstadoVariante</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
			</Fields>
		</DataSet>
